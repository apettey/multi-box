<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MultiBox</AssemblyName>
    <!-- Source of truth for local builds; bumped by scripts/release.ps1. CI overrides with -p:Version from the tag. -->
    <Version>1.0.0</Version>
    <RootNamespace>MultiBox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's native libraries (PresentationNative_cor3, wpfgfx_cor3) cannot be loaded
         from inside a single-file bundle, so they must be extracted to disk. Without this
         a single-file publish dies with DllNotFoundException in SetWindowLongPtrWndProc
         before the window ever shows. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Lets the project restore and build on a non-Windows machine (CI, or a Mac).
         The produced binary still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiBox.Core\MultiBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spoken web warnings. Microsoft-published wrapper over the SAPI voices Windows
         already ships; MultiBox.Core remains dependency-free. -->
    <PackageReference Include="System.Speech" Version="9.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
