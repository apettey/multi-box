<Window x:Class="MultiBox.App.SettingsSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiBox.App"
        Title="Settings Sync — EVE window layout"
        Width="860" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static local:Palette.Panel}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="Sans">IBM Plex Sans, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">IBM Plex Mono, Consolas</FontFamily>

        <!-- One character's core_char file. The radio picks the layout everyone gets; the
             checkbox keeps an alt out of it. -->
        <DataTemplate x:Key="CharacterRow">
            <Border Margin="0,0,0,4" CornerRadius="3" Padding="10,6"
                    Background="{x:Static local:Palette.Page}" BorderThickness="1"
                    BorderBrush="{x:Static local:Palette.CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" GroupName="SyncSource" Content="Source"
                                 VerticalAlignment="Center" FontFamily="{StaticResource Mono}" FontSize="10"
                                 Foreground="{x:Static local:Palette.TextSecondary}"
                                 IsChecked="{Binding IsSource}"/>
                    <CheckBox Grid.Column="1" Content="Sync" VerticalAlignment="Center"
                              FontFamily="{StaticResource Mono}" FontSize="10"
                              Foreground="{x:Static local:Palette.TextSecondary}"
                              IsChecked="{Binding Included}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Sans}" FontSize="12"
                                   Foreground="{x:Static local:Palette.TextPrimary}"/>
                        <TextBlock Text="{Binding IdText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Mono}" FontSize="9"
                                   Foreground="{x:Static local:Palette.TextFaint}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding LastChanged}" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" FontSize="10"
                               Foreground="{x:Static local:Palette.TextMuted}"/>
                    <TextBlock Grid.Column="4" Text="{Binding RoleText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="9"
                               FontWeight="SemiBold" Foreground="{Binding RoleBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="⧉ SETTINGS SYNC" FontFamily="{StaticResource Mono}" FontSize="14"
                       FontWeight="SemiBold" Foreground="{x:Static local:Palette.TextPrimary}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Sans}"
                       FontSize="12" Foreground="{x:Static local:Palette.TextSecondary}"
                       Text="Copies one character's EVE settings — window positions, chat windows, overview — over the others, so every client opens with the same layout. EVE reads these files at login and writes them back at logout, so a sync only happens while every client is closed. The originals are zipped to %APPDATA%\MultiBox\settings-backups first."/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PROFILE" VerticalAlignment="Center" Width="76"
                           FontFamily="{StaticResource Mono}" FontSize="9"
                           Foreground="{x:Static local:Palette.TextMuted}"/>
                <!-- The stock ComboBox stays light, and the app-wide TextBlock style would paint
                     its text light too, so the item text is set dark explicitly. -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          FontFamily="{StaticResource Mono}" FontSize="11">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{x:Static local:Palette.Page}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- The launcher assigns a profile per account, so one fleet can read its settings
                 from several folders. Ticking one copies the source layout into it too. -->
            <Grid Margin="0,10,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOtherProfiles}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ALSO APPLY TO" VerticalAlignment="Top" Width="76" Margin="0,2,0,0"
                           TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="9"
                           Foreground="{x:Static local:Palette.TextMuted}"/>
                <StackPanel Grid.Column="1">
                    <ItemsControl ItemsSource="{Binding OtherProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A TextBlock rather than string Content: string content is
                                     read as an access key and loses the first underscore of
                                     names like Split_Screen. -->
                                <CheckBox Margin="0,0,0,3" IsChecked="{Binding IsChecked}">
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="10"
                                               Foreground="{x:Static local:Palette.TextSecondary}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="9"
                               Foreground="{x:Static local:Palette.Gold}" Text="{Binding AlsoApplySummary}"/>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="10"
                       Text="{Binding ClientsText}" Foreground="{Binding ClientsBrush}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="10"
                       Foreground="{x:Static local:Palette.Danger}" Text="No EVE settings folder found under %LOCALAPPDATA%\CCP\EVE. Log a character in once so EVE creates it.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox Content="Sync automatically once the last EVE client closes"
                      FontFamily="{StaticResource Mono}" FontSize="10"
                      Foreground="{x:Static local:Palette.TextSecondary}"
                      IsChecked="{Binding AutoSync}"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="10"
                       Foreground="{x:Static local:Palette.NeutBlue}" Text="{Binding Message}"/>

            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding LastSyncText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource Mono}" FontSize="10"
                           Foreground="{x:Static local:Palette.TextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border CornerRadius="3" Padding="14,6" Cursor="Hand" Margin="0,0,8,0"
                            BorderThickness="1" BorderBrush="{x:Static local:Palette.CardBorder}"
                            MouseLeftButtonUp="Restore_Click"
                            ToolTip="Put back the files from before the most recent sync of this profile">
                        <TextBlock Text="RESTORE LAST BACKUP" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.TextSecondary}"/>
                    </Border>
                    <Border x:Name="SyncButton" CornerRadius="3" Padding="14,6" Cursor="Hand" Margin="0,0,8,0"
                            BorderThickness="1" BorderBrush="{x:Static local:Palette.Gold}"
                            MouseLeftButtonUp="Sync_Click" IsEnabled="{Binding CanSync}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="SYNC NOW" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.Gold}"/>
                    </Border>
                    <Border CornerRadius="3" Padding="18,6" Cursor="Hand"
                            Background="{x:Static local:Palette.Inset}" BorderThickness="1"
                            BorderBrush="{x:Static local:Palette.NeutBlue}" MouseLeftButtonUp="Close_Click">
                        <TextBlock Text="DONE" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.NeutBlue}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource CharacterRow}"/>
        </ScrollViewer>
    </DockPanel>
</Window>
