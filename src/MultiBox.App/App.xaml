<Application x:Class="MultiBox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MultiBox.App"
             StartupUri="FleetWindow.xaml">
    <Application.Resources>
        <!-- The palette lives in Palette.cs, not here: most of it is selected at runtime
             (a log row's colour follows the event kind, a badge's the effect), and one
             source of truth beats a dictionary that code-behind looks strings up in. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static local:Palette.TextBody}"/>
            <Setter Property="FontFamily" Value="IBM Plex Sans, Segoe UI"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{x:Static local:Palette.TextMuted}"/>
        </Style>
    </Application.Resources>
</Application>
