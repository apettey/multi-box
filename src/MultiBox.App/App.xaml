<Application x:Class="MultiBox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- EVE-adjacent dark palette: the dashboard sits beside the game, so it should not
             be the brightest thing on the screen. -->
        <SolidColorBrush x:Key="Bg" Color="#FF0B0E13"/>
        <SolidColorBrush x:Key="Panel" Color="#FF141A22"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#FF1B2430"/>
        <SolidColorBrush x:Key="Line" Color="#FF2A3646"/>
        <SolidColorBrush x:Key="Text" Color="#FFD6E1F0"/>
        <SolidColorBrush x:Key="Dim" Color="#FF7C8CA3"/>
        <SolidColorBrush x:Key="Accent" Color="#FF3FA7FF"/>
        <SolidColorBrush x:Key="Good" Color="#FF57D98A"/>
        <SolidColorBrush x:Key="Warn" Color="#FFFFB300"/>
        <SolidColorBrush x:Key="Danger" Color="#FFFF4D4D"/>
        <SolidColorBrush x:Key="Off" Color="#FF2A3646"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
    </Application.Resources>
</Application>
