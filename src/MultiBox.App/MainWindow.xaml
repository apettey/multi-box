<Window x:Class="MultiBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiBox.App"
        Title="MultiBox - EVE fleet dashboard"
        Height="760" Width="1180"
        Background="{StaticResource Bg}"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <local:BoolToBrushConverter x:Key="ActiveBrush"
                                    ActiveBrush="{StaticResource Danger}"
                                    InactiveBrush="{StaticResource Off}"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:RateConverter x:Key="Rate"/>

        <!-- One EWAR lamp. Unobservable effects (webs, painters) are drawn at low opacity
             so a dark lamp is never read as "definitely not happening". -->
        <DataTemplate x:Key="EwarLamp">
            <Border Margin="0,0,4,0" CornerRadius="3" Padding="6,3"
                    ToolTip="{Binding Tooltip}"
                    Background="{Binding IsActive, Converter={StaticResource ActiveBrush}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsObservable}" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <!-- One pilot tile. -->
        <DataTemplate x:Key="CharacterTile">
            <Border Width="352" Margin="6" Padding="10" CornerRadius="6"
                    Background="{StaticResource Panel}" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsForeground}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UnderEwar}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="34" Height="34" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding PortraitUrl}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Ship}" Style="{StaticResource Label}"/>
                        </StackPanel>

                        <Ellipse Grid.Column="2" Width="9" Height="9" VerticalAlignment="Top"
                                 ToolTip="EVE client detected"
                                 Fill="{Binding ClientRunning, Converter={StaticResource ActiveBrush},
                                        ConverterParameter=good}"/>
                    </Grid>

                    <UniformGrid Columns="3" Margin="0,10,0,6">
                        <StackPanel>
                            <TextBlock Text="DPS OUT" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Stat}" Foreground="{StaticResource Accent}"
                                       Text="{Binding DpsOut, Converter={StaticResource Rate}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DPS IN" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Stat}" Foreground="{StaticResource Danger}"
                                       Text="{Binding DpsIn, Converter={StaticResource Rate}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="NEUT IN" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Stat}" Foreground="{StaticResource Warn}"
                                       Text="{Binding NeutIn, Converter={StaticResource Rate}}"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="REPS OUT" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Stat}" FontSize="15" Foreground="{StaticResource Good}"
                                       Text="{Binding RepsOut, Converter={StaticResource Rate}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="REPS IN" Style="{StaticResource Label}"/>
                            <TextBlock Style="{StaticResource Stat}" FontSize="15" Foreground="{StaticResource Good}"
                                       Text="{Binding RepsIn, Converter={StaticResource Rate}}"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="EWAR ON ME" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Indicators}" ItemTemplate="{StaticResource EwarLamp}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="4,0,4,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="MultiBox" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Label}" Text="{Binding Status}"/>
            <CheckBox DockPanel.Dock="Right" Content="Mute alerts" Foreground="{StaticResource Dim}"
                      VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding Muted}"/>
            <CheckBox DockPanel.Dock="Right" x:Name="TopmostToggle" Content="Always on top"
                      Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                      Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
            <CheckBox DockPanel.Dock="Right" x:Name="PreviewsToggle" Content="Client previews"
                      Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"
                      Checked="Previews_Changed" Unchecked="Previews_Changed"/>
        </DockPanel>

        <!-- Pilot tiles -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Characters}" ItemTemplate="{StaticResource CharacterTile}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Unified chat -->
        <Border Grid.Row="2" Margin="6,10,6,0" CornerRadius="6" Padding="8"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="UNIFIED CHAT (read only)"
                               Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Right" Width="150" ItemsSource="{Binding Channels}"
                              SelectedItem="{Binding SelectedChannel}"/>
                </DockPanel>

                <ListBox Grid.Row="1" x:Name="ChatList" ItemsSource="{Binding Chat}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="2"/>
                            <!-- Read-only by design: selection is allowed for copying, but
                                 there is no input path back to the game. -->
                            <Setter Property="Focusable" Value="True"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas"
                                           FontSize="11" Foreground="{StaticResource Dim}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="11"
                                           Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Sender}" FontSize="12"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Text}" FontSize="12"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- How many clients logged this line; 1 of 4 can mean a
                                     character was not in the channel. -->
                                <TextBlock Grid.Column="4" Text="{Binding Witnesses}" FontSize="10"
                                           Foreground="{StaticResource Dim}" HorizontalAlignment="Right"
                                           ToolTip="{Binding WitnessTooltip}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="6,6,6,0" Style="{StaticResource Label}"
                   Text="Webs, target painters, sensor dampeners and tracking disruptors are shown greyed: EVE writes no game-log line when they are applied, so they cannot be detected from logs."/>
    </Grid>
</Window>
