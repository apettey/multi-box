<Window x:Class="MultiBox.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="360" Height="190"
        MinWidth="120" MinHeight="80"
        WindowStartupLocation="Manual"
        Background="{StaticResource Bg}">

    <!-- AllowsTransparency is deliberately left false: a layered window is composited by a
         path that does not draw DWM thumbnails, so switching it on makes every preview blank. -->

    <Border x:Name="Frame" BorderThickness="2" BorderBrush="{StaticResource Line}"
            Background="{StaticResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The thumbnail is painted by the compositor over our client area, so anything
                 that must stay visible has to live outside ThumbHost's rectangle. -->
            <DockPanel x:Name="Header" Grid.Row="0" Background="{StaticResource Panel}"
                       LastChildFill="False" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="NameText" DockPanel.Dock="Left" Margin="6,3" FontSize="11"
                           FontWeight="SemiBold" Text="—"/>
                <TextBlock x:Name="StateText" DockPanel.Dock="Right" Margin="6,3" FontSize="10"
                           Foreground="{StaticResource Dim}" Text=""/>
            </DockPanel>

            <Grid x:Name="ThumbHost" Grid.Row="1">
                <TextBlock x:Name="Placeholder" Text="client not running"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource Dim}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
