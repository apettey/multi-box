<Window x:Class="MultiBox.App.FleetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiBox.App"
        Title="Fleet Command — MultiBox"
        Height="1340" Width="2400"
        MinHeight="900" MinWidth="1600"
        Background="{x:Static local:Palette.Page}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- IBM Plex is the design's typeface; the fallbacks are what Windows always has, so
             the layout holds whether or not Plex is installed. -->
        <FontFamily x:Key="Sans">IBM Plex Sans, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">IBM Plex Mono, Consolas</FontFamily>

        <local:AspectRatioConverter x:Key="Aspect"/>
        <local:BoolToVisibilityConverter x:Key="Show"/>

        <!-- The 45° hatch standing in for a client that is not running. -->
        <DrawingBrush x:Key="Hatch" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{x:Static local:Palette.HatchDark}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,12,12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{x:Static local:Palette.HatchLight}">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,12 L12,0 L12,6 L6,12 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Label style: small, spaced, uppercase mono. Used for every field caption. -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{x:Static local:Palette.TextMuted}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Pulses. The design specifies these as CSS keyframes; in WPF they are opacity
             animations over a glow layer, which costs far less than animating a shadow. -->
        <Storyboard x:Key="ThreatPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1"
                             Duration="0:0:0.7"/>
        </Storyboard>
        <Storyboard x:Key="TankRed" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1"
                             Duration="0:0:0.4"/>
        </Storyboard>
        <Storyboard x:Key="RepGreen" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="0.75"
                             Duration="0:0:0.8"/>
        </Storyboard>
        <Storyboard x:Key="WebFlash" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1"
                             Duration="0:0:0.45"/>
        </Storyboard>

        <!-- One EWAR chip. -->
        <DataTemplate x:Key="EwarBadge">
            <Border Margin="0,0,4,4" CornerRadius="3" Padding="7,2"
                    Background="{Binding Background}" BorderThickness="1"
                    BorderBrush="{Binding Foreground}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="9"
                               FontWeight="SemiBold" Foreground="{Binding Foreground}"/>
                    <TextBlock Text="{Binding Source}" Margin="5,0,0,0" FontFamily="{StaticResource Mono}"
                               FontSize="9" Foreground="{x:Static local:Palette.TextSecondary}"/>
                </StackPanel>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsWeb}" Value="True"/>
                                    <Condition Binding="{Binding DataContext.AlertFlash,
                                        RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard Name="WebPulse" Storyboard="{StaticResource WebFlash}"/>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="WebPulse"/>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- One combat-log row. -->
        <DataTemplate x:Key="LogRow">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Mono}" FontSize="10"
                           Foreground="{x:Static local:Palette.TextFaint}"/>
                <TextBlock Text="{Binding Text}" Margin="6,0,0,0" FontFamily="{StaticResource Mono}"
                           FontSize="10" Foreground="{Binding Foreground}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

        <!-- One character card. -->
        <DataTemplate x:Key="CharacterCard">
            <Grid Margin="5" Opacity="{Binding CardOpacity}"
                  AllowDrop="True"
                  MouseMove="Card_MouseMove"
                  DragOver="Card_DragOver"
                  Drop="Card_Drop">
                <Border Background="{x:Static local:Palette.Panel}" CornerRadius="5"
                        BorderThickness="1" BorderBrush="{Binding CardBorderBrush}"/>

                <!-- Threat glow, drawn over the border rather than replacing it so the card
                     does not change size when it starts pulsing. -->
                <Border x:Name="ThreatGlow" CornerRadius="5" BorderThickness="1" Opacity="0"
                        BorderBrush="{x:Static local:Palette.Danger}" IsHitTestVisible="False"/>

                <DockPanel Margin="0">
                    <!-- header -->
                    <Grid DockPanel.Dock="Top" Margin="10,9,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource Sans}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{x:Static local:Palette.TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Ship}" Margin="8,0,0,0"
                                   VerticalAlignment="Bottom" FontFamily="{StaticResource Mono}"
                                   FontSize="10" Foreground="{x:Static local:Palette.TextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Cycle-group membership, so the switcher order is readable from
                                 the dashboard and not only inside its config window. -->
                            <ItemsControl ItemsSource="{Binding CycleTags}" Margin="0,0,6,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,0" CornerRadius="3" Padding="4,1"
                                                BorderThickness="1"
                                                BorderBrush="{x:Static local:Palette.NeutBlue}">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Mono}"
                                                       FontSize="9"
                                                       Foreground="{x:Static local:Palette.NeutBlue}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border CornerRadius="3" Padding="5,1" BorderThickness="1"
                                    BorderBrush="{Binding RoleBrush}">
                                <TextBlock Text="{Binding Role}" FontFamily="{StaticResource Mono}" FontSize="9"
                                           Foreground="{Binding RoleBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- live client thumbnail; the compositor draws into this rectangle -->
                    <!-- MaxWidth caps how much of a card the preview may take. Without it a
                         four-pilot fleet lays out 2x2, each card runs ~800px wide, and a
                         16:9 slot swallows the numbers the dashboard exists to show. -->
                    <Border DockPanel.Dock="Top" Tag="ThumbSlot" Margin="10,0,10,0" Cursor="Hand"
                            MaxWidth="440"
                            CornerRadius="3" BorderThickness="1" Background="{StaticResource Hatch}"
                            BorderBrush="{x:Static local:Palette.Divider}"
                            MouseLeftButtonUp="Thumbnail_Click"
                            ToolTip="Click to bring this client to the front"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self},
                                     Converter={StaticResource Aspect}}"
                            Visibility="{Binding DataContext.ShowThumbnails,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource Show}}">
                        <Grid>
                            <TextBlock Text="client not running" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="{StaticResource Mono}"
                                       FontSize="10" Foreground="{x:Static local:Palette.TextFaint}"/>
                            <TextBlock Text="{Binding Hotkey}" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" Margin="0,0,6,4"
                                       FontFamily="{StaticResource Mono}" FontSize="9"
                                       Foreground="{x:Static local:Palette.TextFaint}"/>
                        </Grid>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{x:Static local:Palette.Hover}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- incoming DPS block -->
                    <Grid DockPanel.Dock="Top" Margin="2,2,2,0">
                        <Border x:Name="TankGlow" CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
                        <StackPanel Margin="8,6,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="INCOMING DPS" Style="{StaticResource Caption}"/>
                                <TextBlock Text="▲ EXCEEDS REPS" Margin="8,0,0,0"
                                           FontFamily="{StaticResource Mono}" FontSize="9"
                                           FontWeight="SemiBold" Foreground="{x:Static local:Palette.Danger}"
                                           Visibility="{Binding Tanking, Converter={StaticResource Show}}"/>
                                <TextBlock Text="● REPS HOLDING" Margin="8,0,0,0"
                                           FontFamily="{StaticResource Mono}" FontSize="9"
                                           FontWeight="SemiBold" Foreground="{x:Static local:Palette.Success}"
                                           Visibility="{Binding Stable, Converter={StaticResource Show}}"/>
                            </StackPanel>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DpsInText}"
                                           FontFamily="{StaticResource Mono}" FontSize="24"
                                           FontWeight="SemiBold" Foreground="{Binding DpsInBrush}"
                                           VerticalAlignment="Center"/>
                                <!-- Reps drawn under incoming: the question the pair answers is
                                     "is the green keeping up with the red". -->
                                <Viewbox Grid.Column="1" Height="22" Margin="8,0,0,0" Stretch="Fill">
                                    <Canvas Width="100" Height="22">
                                        <Polyline Points="{Binding SparkReps}" StrokeThickness="1.4"
                                                  Opacity="0.8" Stroke="{x:Static local:Palette.Success}"/>
                                        <Polyline Points="{Binding SparkIn}" StrokeThickness="1.4"
                                                  Opacity="0.85" Stroke="{x:Static local:Palette.Danger}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- stats row -->
                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="10,6,10,4">
                        <StackPanel>
                            <TextBlock Text="DPS OUT" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding DpsOutText}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding DpsOutBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="REPS IN" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding RepsInText}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding RepsInBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CAP XFER" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding CapInText}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding CapInBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="NEUT/NOS" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding NeutInText}" Style="{StaticResource StatValue}"
                                       Foreground="{Binding NeutInBrush}"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- EWAR badges sit at the bottom, so a card's threat state is always in
                         the same place regardless of how long its log is. -->
                    <Border DockPanel.Dock="Bottom" Margin="10,0,10,10" MinHeight="24">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Ewar}" ItemTemplate="{StaticResource EwarBadge}"
                                          VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="NO EWAR" VerticalAlignment="Bottom" Margin="0,2"
                                       FontFamily="{StaticResource Mono}" FontSize="9"
                                       Foreground="{x:Static local:Palette.TextDisabled}"
                                       Visibility="{Binding NoEwar, Converter={StaticResource Show}}"/>
                        </Grid>
                    </Border>

                    <!-- per-character combat log fills whatever is left -->
                    <Border Margin="10,6,10,0" Padding="0,6,0,0" BorderThickness="0,1,0,0"
                            BorderBrush="{x:Static local:Palette.LogSeparator}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Log}" ItemTemplate="{StaticResource LogRow}"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding UnderEwar}" Value="True"/>
                        <Condition Binding="{Binding DataContext.AlertFlash,
                            RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="Threat" Storyboard="{StaticResource ThreatPulse}"
                                         Storyboard.TargetName="ThreatGlow"/>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Threat"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tanking}" Value="True"/>
                        <Condition Binding="{Binding DataContext.AlertFlash,
                            RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TankGlow" Property="Background" Value="{x:Static local:Palette.Danger}"/>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="Tank" Storyboard="{StaticResource TankRed}"
                                         Storyboard.TargetName="TankGlow"/>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Tank"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Stable}" Value="True"/>
                        <Condition Binding="{Binding DataContext.AlertFlash,
                            RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TankGlow" Property="Background" Value="{x:Static local:Palette.Success}"/>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="Rep" Storyboard="{StaticResource RepGreen}"
                                         Storyboard.TargetName="TankGlow"/>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Rep"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Comms row. -->
        <DataTemplate x:Key="CommsRow">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource Mono}"
                           FontSize="10" Foreground="{x:Static local:Palette.TextMuted}"
                           VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ChannelTag}" Margin="8,2,0,0" MinWidth="52"
                           MaxWidth="110" FontFamily="{StaticResource Mono}" FontSize="9"
                           FontWeight="SemiBold" Foreground="{Binding ChannelBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="2" Margin="8,0,0,0" TextWrapping="Wrap" FontSize="13"
                           FontFamily="{StaticResource Sans}"
                           Foreground="{x:Static local:Palette.TextBody}">
                    <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{x:Static local:Palette.TextPrimary}"/><Run Text="{Binding Text, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Grid.Column="3" Text="{Binding MergeText}" Margin="8,2,0,0"
                           ToolTip="{Binding MergeTooltip}" FontFamily="{StaticResource Mono}"
                           FontSize="9" Foreground="{x:Static local:Palette.TextFaint}"
                           VerticalAlignment="Top"
                           Visibility="{Binding IsMerged, Converter={StaticResource Show}}"/>
            </Grid>
        </DataTemplate>

        <!-- Channel filter chip. -->
        <DataTemplate x:Key="ChannelChip">
            <Border Margin="0,0,4,4" CornerRadius="3" Padding="10,3" Cursor="Hand"
                    Background="{Binding Background}" BorderThickness="1"
                    BorderBrush="{Binding BorderBrush}" MouseLeftButtonUp="Channel_Click">
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="10"
                           Foreground="{Binding Foreground}"/>
            </Border>
        </DataTemplate>

        <!-- Squad tab. -->
        <DataTemplate x:Key="SquadTab">
            <Border CornerRadius="3" Padding="12,4" Cursor="Hand" Background="{Binding Background}"
                    MouseLeftButtonUp="Squad_Click">
                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="11"
                           Foreground="{Binding Foreground}"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Border Grid.Row="0" Background="{x:Static local:Palette.Header}" BorderThickness="0,0,0,1"
                BorderBrush="{x:Static local:Palette.Divider}">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{x:Static local:Palette.Success}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="FLEET COMMAND" Margin="10,0,0,0" FontFamily="{StaticResource Mono}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{x:Static local:Palette.TextPrimary}"
                               VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="PELD + EVE-O · UNIFIED" Margin="10,0,0,0"
                               FontFamily="{StaticResource Mono}" FontSize="11"
                               Foreground="{x:Static local:Palette.TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" Margin="16,0,0,0" FontFamily="{StaticResource Mono}"
                               FontSize="11" Foreground="{x:Static local:Palette.TextFaint}"
                               VerticalAlignment="Center" MaxWidth="420"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HiddenText}" Margin="8,0,0,0"
                               FontFamily="{StaticResource Mono}" FontSize="11"
                               Foreground="{x:Static local:Palette.TextDisabled}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,28,0">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="FLEET INCOMING" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding FleetIncoming}" FontFamily="{StaticResource Mono}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{x:Static local:Palette.Danger}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="REPS IN" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding FleetReps}" FontFamily="{StaticResource Mono}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{x:Static local:Palette.Success}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="NEUT PRESSURE" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding FleetNeut}" FontFamily="{StaticResource Mono}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{x:Static local:Palette.NeutBlue}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="EWAR ALERTS" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding EwarAlerts}" FontFamily="{StaticResource Mono}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{Binding EwarAlertBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{x:Static local:Palette.Chrome}" CornerRadius="4" Padding="2"
                            BorderThickness="1" BorderBrush="{x:Static local:Palette.CardBorder}">
                        <ItemsControl ItemsSource="{Binding Squads}" ItemTemplate="{StaticResource SquadTab}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="CARDS" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" FontSize="9"
                               Foreground="{x:Static local:Palette.TextMuted}"/>
                    <Slider Width="90" Margin="6,0,0,0" VerticalAlignment="Center"
                            Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            ToolTip="Cards per squad tab; the rest move to the next squad"
                            Value="{Binding SquadSize, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding SquadSize}" Margin="6,0,0,0" VerticalAlignment="Center"
                               MinWidth="18" FontFamily="{StaticResource Mono}" FontSize="11"
                               Foreground="{x:Static local:Palette.NeutBlue}"/>

                    <Border Margin="10,0,0,0" CornerRadius="3" Padding="10,4" Cursor="Hand"
                            BorderThickness="1" BorderBrush="{x:Static local:Palette.CardBorder}"
                            MouseLeftButtonUp="Order_Click"
                            ToolTip="Reorder the fleet and move characters between squads">
                        <TextBlock Text="≡ ORDER" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.TextSecondary}"/>
                    </Border>

                    <CheckBox Content="Open only" Margin="10,0,0,0" VerticalAlignment="Center"
                              FontFamily="{StaticResource Mono}" FontSize="10"
                              Foreground="{x:Static local:Palette.TextMuted}"
                              ToolTip="Show a card only while that character's client is open"
                              IsChecked="{Binding OnlyRunningClients}"/>

                    <CheckBox Content="Thumbnails" Margin="10,0,0,0" VerticalAlignment="Center"
                              FontFamily="{StaticResource Mono}" FontSize="10"
                              Foreground="{x:Static local:Palette.TextMuted}"
                              IsChecked="{Binding ShowThumbnails}"/>
                    <CheckBox Content="Flash" Margin="10,0,0,0" VerticalAlignment="Center"
                              FontFamily="{StaticResource Mono}" FontSize="10"
                              Foreground="{x:Static local:Palette.TextMuted}"
                              IsChecked="{Binding AlertFlash}"/>
                    <CheckBox Content="Voice" Margin="10,0,0,0" VerticalAlignment="Center"
                              FontFamily="{StaticResource Mono}" FontSize="10"
                              Foreground="{x:Static local:Palette.TextMuted}"
                              IsChecked="{Binding VoiceAlerts}"/>
                    <CheckBox Content="Mute tones" Margin="10,0,0,0" VerticalAlignment="Center"
                              FontFamily="{StaticResource Mono}" FontSize="10"
                              Foreground="{x:Static local:Palette.TextMuted}"
                              IsChecked="{Binding Muted}"/>

                    <Border Margin="14,0,0,0" CornerRadius="3" Padding="10,4" Cursor="Hand"
                            BorderThickness="1" BorderBrush="{x:Static local:Palette.CardBorder}"
                            MouseLeftButtonUp="CycleGroups_Click"
                            ToolTip="Fast Screen Switcher: hotkeys that cycle between clients">
                        <TextBlock Text="⇄ CYCLE GROUPS" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.TextSecondary}"/>
                    </Border>

                    <Border Margin="8,0,0,0" CornerRadius="3" Padding="10,4" Cursor="Hand"
                            BorderThickness="1" BorderBrush="{x:Static local:Palette.NeutBlue}"
                            MouseLeftButtonUp="TestVoice_Click" ToolTip="Test the spoken web warning">
                        <TextBlock Text="🔊 VOICE" FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.NeutBlue}"/>
                    </Border>

                    <TextBlock Text="{Binding EveClock}" Margin="14,0,0,0"
                               FontFamily="{StaticResource Mono}" FontSize="13"
                               Foreground="{x:Static local:Palette.TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ main row ============================ -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="CardHost" Grid.Column="0" ItemsSource="{Binding Cards}"
                          ItemTemplate="{StaticResource CharacterCard}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GridColumns,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     Rows="{Binding DataContext.GridRows,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Grid.Column="1" Margin="5" Background="{x:Static local:Palette.Panel}"
                    CornerRadius="5" BorderThickness="1"
                    BorderBrush="{x:Static local:Palette.CardBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,9" BorderThickness="0,0,0,1"
                            BorderBrush="{x:Static local:Palette.Divider}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="UNIFIED COMMS" FontFamily="{StaticResource Mono}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Static local:Palette.TextPrimary}"/>
                                <Border Margin="8,0,0,0" CornerRadius="3" Padding="5,1" BorderThickness="1"
                                        BorderBrush="{x:Static local:Palette.CardBorder}">
                                    <TextBlock Text="READ ONLY" FontFamily="{StaticResource Mono}"
                                               FontSize="9" Foreground="{x:Static local:Palette.TextMuted}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding MergedText}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource Mono}" FontSize="10"
                                           Foreground="{x:Static local:Palette.Success}"/>
                                <Border Margin="10,0,0,0" CornerRadius="3" Padding="8,2" Cursor="Hand"
                                        BorderThickness="1"
                                        BorderBrush="{x:Static local:Palette.CardBorder}"
                                        MouseLeftButtonUp="ClearComms_Click"
                                        ToolTip="Empty the view. Nothing on disk is touched.">
                                    <TextBlock Text="CLEAR" FontFamily="{StaticResource Mono}"
                                               FontSize="9"
                                               Foreground="{x:Static local:Palette.TextMuted}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="12,8,12,4" MaxHeight="72">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Channels}"
                                          ItemTemplate="{StaticResource ChannelChip}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="12,7" BorderThickness="0,1,0,0"
                            BorderBrush="{x:Static local:Palette.Divider}">
                        <TextBlock Text="×N = identical message merged from N client windows · newest first"
                                   FontFamily="{StaticResource Mono}" FontSize="9"
                                   Foreground="{x:Static local:Palette.TextFaint}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Padding="12,4,12,10" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource CommsRow}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
