<Window x:Class="MultiBox.App.CycleGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultiBox.App"
        Title="Cycle Groups — Fast Screen Switcher"
        Width="920" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{x:Static local:Palette.Panel}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="Sans">IBM Plex Sans, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">IBM Plex Mono, Consolas</FontFamily>

        <!-- Declared before the templates that use it: StaticResource resolves against what
             is already in the dictionary, so a forward reference throws at load. -->
        <local:BoolToVisibilityConverter x:Key="Show"/>

        <!-- One character chip in a group's roster. Selected chips carry their 1-based
             position, because the cycle order is the whole point of the list. -->
        <DataTemplate x:Key="MemberChip">
            <Border Margin="0,0,6,6" CornerRadius="3" Padding="9,4" Cursor="Hand"
                    Background="{Binding Background}" BorderThickness="1"
                    BorderBrush="{Binding BorderBrush}"
                    MouseLeftButtonUp="Member_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Position}" Margin="0,0,6,0"
                               FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{x:Static local:Palette.NeutBlue}"
                               Visibility="{Binding IsMember, Converter={StaticResource Show}}"/>
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Sans}" FontSize="12"
                               Foreground="{Binding Foreground}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One cycle group panel. -->
        <DataTemplate x:Key="GroupPanel">
            <Border Margin="0,0,0,10" CornerRadius="5" Padding="14,12"
                    Background="{x:Static local:Palette.Page}" BorderThickness="1"
                    BorderBrush="{x:Static local:Palette.CardBorder}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Mono}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{x:Static local:Palette.TextPrimary}"/>
                        <TextBlock Text="{Binding OrderLine}" HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Mono}" FontSize="10"
                                   Foreground="{x:Static local:Palette.TextMuted}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="FORWARD" VerticalAlignment="Center" Width="76"
                                   FontFamily="{StaticResource Mono}" FontSize="9"
                                   Foreground="{x:Static local:Palette.TextMuted}"/>
                        <TextBox Text="{Binding ForwardHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Padding="6,3" FontFamily="{StaticResource Mono}" FontSize="11"
                                 Background="{x:Static local:Palette.Inset}" BorderThickness="1"
                                 BorderBrush="{x:Static local:Palette.NeutBlue}"
                                 Foreground="{x:Static local:Palette.NeutBlue}" CaretBrush="White"/>
                        <TextBlock Text="BACKWARD" VerticalAlignment="Center" Width="90" Margin="18,0,0,0"
                                   FontFamily="{StaticResource Mono}" FontSize="9"
                                   Foreground="{x:Static local:Palette.TextMuted}"/>
                        <TextBox Text="{Binding BackwardHotkey, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Padding="6,3" FontFamily="{StaticResource Mono}" FontSize="11"
                                 Background="{x:Static local:Palette.Inset}" BorderThickness="1"
                                 BorderBrush="{x:Static local:Palette.CardBorder}"
                                 Foreground="{x:Static local:Palette.NeutBlue}" CaretBrush="White"/>
                    </StackPanel>

                    <TextBlock Text="Click a character to add or remove it. Click order is cycle order."
                               Margin="0,12,0,6" FontFamily="{StaticResource Mono}" FontSize="9"
                               Foreground="{x:Static local:Palette.TextFaint}"/>

                    <ItemsControl ItemsSource="{Binding Roster}" ItemTemplate="{StaticResource MemberChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="⇄ CYCLE GROUPS" FontFamily="{StaticResource Mono}" FontSize="14"
                       FontWeight="SemiBold" Foreground="{x:Static local:Palette.TextPrimary}"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Sans}"
                       FontSize="12" Foreground="{x:Static local:Palette.TextSecondary}"
                       Text="A hotkey steps the foreground through a group's clients, wrapping at the end and skipping any client that is not running. Hotkeys are global, so they work while EVE has focus. Write them as F13, Control+F13 or Shift+Alt+D."/>
            <TextBlock x:Name="RejectedNote" Margin="0,6,0,0" TextWrapping="Wrap"
                       FontFamily="{StaticResource Mono}" FontSize="10"
                       Foreground="{x:Static local:Palette.Danger}" Visibility="Collapsed"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border CornerRadius="3" Padding="14,6" Cursor="Hand" Margin="0,0,8,0"
                        BorderThickness="1" BorderBrush="{x:Static local:Palette.CardBorder}"
                        MouseLeftButtonUp="Import_Click"
                        ToolTip="Read cycle groups and aliases from EVE-O Preview's config">
                    <TextBlock Text="IMPORT FROM EVE-O" FontFamily="{StaticResource Mono}" FontSize="10"
                               Foreground="{x:Static local:Palette.TextSecondary}"/>
                </Border>
                <Border CornerRadius="3" Padding="18,6" Cursor="Hand"
                        Background="{x:Static local:Palette.Inset}" BorderThickness="1"
                        BorderBrush="{x:Static local:Palette.NeutBlue}" MouseLeftButtonUp="Close_Click">
                    <TextBlock Text="DONE" FontFamily="{StaticResource Mono}" FontSize="10"
                               Foreground="{x:Static local:Palette.NeutBlue}"/>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource GroupPanel}"/>
        </ScrollViewer>
    </DockPanel>
</Window>
